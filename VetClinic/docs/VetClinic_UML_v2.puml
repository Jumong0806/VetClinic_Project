Animal "1" *-- "0..*" TreatmentRecord : treatmentHistory
Animal "1" --> "1" Owner : owner
TreatmentRecord "0..*" --> "1" Staff : performedBy
ClinicManager "1" o-- "0..*" Animal : animals
ClinicManager "1" o-- "0..*" Staff : staffMembers
ClinicManager --> Storable : storage
AuthService --> ClinicManager : manager
AuthService --> "0..1" Staff : currentStaff
AuthService ..> AuthenticationException : throws
Staff ..> PasswordUtil : uses
Staff ..> Treatable : treat(...)
Storable ..> StorageException : throws
Main ..> ClinicManager : creates
